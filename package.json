{
  "name": "universal-elearning-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:generate": "tsx scripts/generate.ts",
    "format": "prettier --write src scripts tests e2e prisma/seed.ts *.ts *.mjs *.json *.yaml",
    "admin:password": "node --env-file=.env --import tsx scripts/set-admin-password.ts",
    "export:demo": "node --env-file=.env --import tsx scripts/export-demo.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.1",
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.22",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "libxmljs2": "0.37.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "scorm-again": "3.5.0",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0"
}
