    "logo": "",
    "backgroundImage": ""
  },
  "header": {
    "title": "Universal Slide Composer — demonstration",
    "subtitle": "Interactive learning experience",
    "showLife": true,
    "showLogo": true
  },
  "levels": [
    {
      "id": "composer:demo-level",
      "title": "Composer acceptance",
      "slides": [
        {
          "id": "composer:intro",
          "title": "Content-only orientation",
          "kind": "composed",
          "text": "",
          "image": "",
          "background": "",
          "composition": {
            "version": 1,
            "layout": {
              "variant": "stacked",
              "regions": [
                "main"
              ]
            },
            "blocks": [
              {
                "id": "intro:first",
                "version": 1,
                "region": "main",
                "layer": "base",
                "visible": true,
                "required": false,
                "kind": "content",
                "text": "This slide has multiple content sections and no question. Reveal the details, then mark it complete."
              },
              {
                "id": "intro:details",
                "version": 1,
                "region": "main",
                "layer": "base",
                "visible": false,
                "required": true,
                "kind": "content",
                "text": "These required details are revealed by an explicit button action."
              },
              {
                "id": "intro:reveal",
                "version": 1,
                "region": "main",
                "layer": "base",
                "visible": true,
                "required": false,
                "kind": "button",
                "label": "Reveal details"
              },
              {
                "id": "intro:last",
                "version": 1,
                "region": "main",
                "layer": "base",
                "visible": true,
                "required": false,
                "kind": "content",
                "text": "Content can appear before or after a control. There is no fixed question position."
              },
              {
                "id": "intro:complete",
                "version": 1,
                "region": "main",
                "layer": "base",
                "visible": true,
                "required": false,
                "kind": "button",
                "label": "Mark slide complete"
              }
            ],
            "rules": [
              {
                "id": "intro:show-rule",
                "trigger": {
                  "event": "activate",
                  "sourceId": "intro:reveal"
                },
                "actions": [
                  {
                    "type": "show",
                    "targetId": "intro:details"
                  }
                ]
              },
              {
                "id": "intro:complete-rule",
                "trigger": {
                  "event": "activate",
                  "sourceId": "intro:complete"
                },
                "actions": [
                  {
                    "type": "complete"
                  }
                ]
              }
            ],
            "completion": {
              "mode": "manual",
              "required": true,
              "interactionIds": []
            },
            "navigation": "after-completion"
          },
          "options": [
            {
              "id": "a",
              "text": "Demonstration option A"
            },
            {
              "id": "b",
              "text": "Demonstration option B"
            }
          ],
          "correctId": "a",
          "correctFeedback": "Correct — demonstration feedback.",
          "incorrectFeedback": "Try again — demonstration feedback. Review the content before continuing."
        },
